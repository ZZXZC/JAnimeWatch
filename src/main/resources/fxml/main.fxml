<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Text?>
<?import javafx.geometry.Insets?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.janimewatch.MainController"
           fx:id="rootPane"
           styleClass="root-pane">

    <!-- ===== Background Layers ===== -->
    <Region styleClass="bg-base"/>

    <ImageView fx:id="bgImage1"
               preserveRatio="false"
               fitWidth="900" fitHeight="650"
               opacity="0.5"
               pickOnBounds="false"
               mouseTransparent="true"
               styleClass="anime-bg-image">
        <image>
            <Image url="@../images/anime-bg-1.png"/>
        </image>
    </ImageView>
    <ImageView fx:id="bgImage2"
               preserveRatio="false"
               fitWidth="900" fitHeight="650"
               opacity="0.5"
               pickOnBounds="false"
               mouseTransparent="true"
               styleClass="anime-bg-image">
        <image>
            <Image url="@../images/anime-bg-2.png"/>
        </image>
    </ImageView>

    <Region styleClass="bg-overlay"/>

    <!-- ===== Content ===== -->
    <VBox styleClass="content-root">

        <!-- ===== Custom Title Bar ===== -->
        <HBox styleClass="title-bar"
              alignment="CENTER_LEFT"
              onMousePressed="#onTitleBarPressed"
              onMouseDragged="#onTitleBarDragged"
              onMouseClicked="#onTitleBarDoubleClick">

            <HBox spacing="8" alignment="CENTER_LEFT" styleClass="title-bar-brand">
                <Region styleClass="title-bar-dot"/>
                <Text text="JAnimeWatch" styleClass="title-bar-text"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="minButton" styleClass="window-button"
                    onAction="#onMinimize">
                <graphic>
                    <SVGPath content="M1,5H15V7H1Z" styleClass="window-icon"/>
                </graphic>
            </Button>

            <Button fx:id="maxButton" styleClass="window-button"
                    onAction="#onMaximizeToggle">
                <graphic>
                    <StackPane>
                        <SVGPath fx:id="maximizePath"
                                 content="M0,0H14V14H0ZM2,2V12H12V2Z"
                                 fillRule="EVEN_ODD"
                                 styleClass="window-icon"/>
                        <SVGPath fx:id="restorePath"
                                 content="M5,1H15V11H5ZM7,3V9H13V3ZM0,4H10V12H0ZM2,6V10H8V6Z"
                                 fillRule="EVEN_ODD"
                                 styleClass="window-icon"
                                 visible="false"/>
                    </StackPane>
                </graphic>
            </Button>

            <Button fx:id="closeButton" styleClass="window-button,close-button"
                    onAction="#onClose">
                <graphic>
                    <SVGPath content="M2,1L7,6L12,1L13,2L8,7L13,12L12,13L7,8L2,13L1,12L6,7L1,2Z"
                             styleClass="window-icon"/>
                </graphic>
            </Button>
        </HBox>

        <!-- Main layout -->
        <BorderPane VBox.vgrow="ALWAYS">
            <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>

            <fx:define>
                <ToggleGroup fx:id="playerGroup"/>
            </fx:define>

            <!-- Top: Search Bar (glass card) -->
            <top>
                <VBox styleClass="glass-card" spacing="12">
                    <padding><Insets top="16" right="16" bottom="14" left="16"/></padding>

                    <Text text="JAnimeWatch" styleClass="title-text"/>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <TextField fx:id="searchField"
                                   promptText="Search anime..."
                                   HBox.hgrow="ALWAYS"
                                   onAction="#onSearch"
                                   styleClass="search-field"/>
                        <Button fx:id="searchButton"
                                text="Search"
                                onAction="#onSearch"
                                styleClass="primary-button"/>
                        <Button fx:id="historyButton"
                                text="History"
                                onAction="#onHistory"
                                styleClass="secondary-button"/>
                    </HBox>
                </VBox>
            </top>

            <!-- Center: Results + Output -->
            <center>
                <VBox spacing="10">
                    <padding><Insets top="12" bottom="12"/></padding>

                    <ListView fx:id="resultsList"
                              VBox.vgrow="ALWAYS"
                              styleClass="results-list"/>

                    <TextArea fx:id="outputArea"
                              editable="false"
                              VBox.vgrow="SOMETIMES"
                              styleClass="output-area"
                              prefHeight="96"
                              promptText="Output will appear here..."/>
                </VBox>
            </center>

            <!-- Bottom: Controls (glass card) -->
            <bottom>
                <VBox styleClass="glass-card">
                    <padding><Insets top="12" right="16" bottom="14" left="16"/></padding>
                    <spacing>8</spacing>

                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <Text text="Episode:" styleClass="label-text"/>
                            <Spinner fx:id="episodeSpinner" prefWidth="80" styleClass="modern-spinner"/>
                        </HBox>

                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <Text text="Player:" styleClass="label-text"/>
                            <RadioButton fx:id="mpvRadio" text="mpv" toggleGroup="$playerGroup" styleClass="modern-radio"/>
                            <RadioButton fx:id="vlcRadio" text="vlc" toggleGroup="$playerGroup" styleClass="modern-radio"/>
                        </HBox>

                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <Text text="Quality:" styleClass="label-text"/>
                            <ComboBox fx:id="qualityBox" prefWidth="90" styleClass="modern-combo"/>
                        </HBox>

                        <CheckBox fx:id="dubCheck" text="Dub" styleClass="modern-check"/>
                        <CheckBox fx:id="downloadCheck" text="Download" styleClass="modern-check"
                                  onAction="#onDownloadToggled"/>
                        <CheckBox fx:id="skipCheck" text="Skip Intro" styleClass="modern-check"
                                  onAction="#onSkipToggled"/>
                    </HBox>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button fx:id="watchButton"
                                text="Watch"
                                onAction="#onWatch"
                                styleClass="primary-button"/>
                        <Button fx:id="updateButton"
                                text="Update"
                                onAction="#onUpdate"
                                styleClass="secondary-button"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Text fx:id="statusText" text="Checking dependencies..." styleClass="status-text"/>
                    </HBox>
                </VBox>
            </bottom>
        </BorderPane>
    </VBox>
</StackPane>